<launch>
<!-- start up world -->
  <!-- <include file="$(find potential_field)/launch/map.launch"/> -->
  <!-- <include file="$(find robotont_navigation)/launch/move_base.launch"/> -->
  <!-- <remap from="cmd_vel" to="cmd_vel_robotont"/> -->
  <!-- <include file="$(find potential_field)/launch/robotont_custom.launch"/> -->
  <!-- <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
  </include> -->
  <!-- <include file="$(find drone_ctrl)/launch/bebop_sim.launch"/> -->

  <arg name="world" default="$(find potential_field)/worlds/robotont_custom.world" />
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="world_name" value="$(arg world)"/>
  </include>

  <include file="$(find bebop_gazebo)/launch/spawn_bebop.launch" />
  <node type="rviz" name="rviz" pkg="rviz" args="-d $(find bebop_gazebo)/rviz/rviz.rviz" />
  <!-- load map -->
  <node pkg="drone_spline_dynamic_obs" name="drone_spline_dynamic_obs" type="traj_planner.py" output="screen"/>
  <!-- <node type="rviz" name="rviz" pkg="rviz" args="-d $(find potential_field)/potential_field.rviz" /> -->

</launch>